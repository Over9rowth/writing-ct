{
  "name": "writing-ct",
  "productName": "文风体检台",
  "version": "1.0.0",
  "private": true,
  "description": "文风体检台 — 给文章做一次全面体检：自动抓出啰嗦长句、重复口头禅和浓重的“AI 腔”",
  "author": "Over9rowth",
  "license": "GPL-3.0-only",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "manual": "npm run build && electron scripts/make-manual-pdf.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.10.2",
    "@electron-forge/maker-squirrel": "7.10.2",
    "@electron-forge/maker-zip": "7.10.2",
    "@types/node": "24.10.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "electron": "44.9.3",
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": false,
        "name": "WritingCT",
        "executableName": "WritingCT",
        "appBundleId": "local.instruments.writingct",
        "appCopyright": "Copyright (C) 2026 Over9rowth (GPL-3.0)",
        "appVersion": "0.1.0",
        "icon": "resources/icon.ico",
        "win32metadata": {
          "CompanyName": "Over9rowth",
          "FileDescription": "文风体检台",
          "ProductName": "文风体检台",
          "LegalCopyright": "Copyright (C) 2026 Over9rowth (GPL-3.0)",
          "InternalName": "WritingCT",
          "OriginalFilename": "WritingCT.exe"
        },
        "ignore": [
          "^/tests",
          "^/docs",
          "^/src",
          "^/scripts",
          "^/resources",
          "^/node_modules",
          "^/out",
          "^/out-",
          "^/project_meta",
          "^/SPEC\\.md$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "WritingCT",
            "title": "文风体检台",
            "setupIcon": "resources/icon.ico"
          }
        }
      ]
    }
  },
  "keywords": [
    "electron",
    "typescript",
    "react",
    "desktop-app",
    "windows-app",
    "offline-first",
    "gplv3",
    "text-analysis",
    "writing-tools",
    "readability",
    "nlp",
    "chinese-nlp",
    "stylometry",
    "editor-tools"
  ]
}
